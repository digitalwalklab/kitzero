import AboutView from '../components/AboutView.astro';
import { legalPages } from '../i18n/legalPages';

const page = legalPages.ko.about;
---

<BaseLayout
  locale="ko"
  title={page.metaTitle}
  description={page.metaDesc}
  activeNav="about"
>
  <AboutView locale="ko" />
</BaseLayout>

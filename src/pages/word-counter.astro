---
import BaseLayout from '../layouts/BaseLayout.astro';
import WordCounterView from '../components/WordCounterView.astro';
import { getExtra3Copy } from '../i18n/extraTools3';

const copy = getExtra3Copy('ko').wordCounter;
---

<BaseLayout
  locale="ko"
  title={copy.metaTitle}
  description={copy.metaDesc}
  activeNav="word-counter"
>
  <WordCounterView locale="ko" />
</BaseLayout>

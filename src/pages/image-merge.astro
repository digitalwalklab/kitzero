---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageMergeView from '../components/ImageMergeView.astro';
import { getExtra3Copy } from '../i18n/extraTools3';

const copy = getExtra3Copy('ko').imageMerge;
---

<BaseLayout
  locale="ko"
  title={copy.metaTitle}
  description={copy.metaDesc}
  activeNav="image-merge"
>
  <ImageMergeView locale="ko" />
</BaseLayout>

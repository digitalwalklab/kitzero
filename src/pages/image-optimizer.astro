import ImageOptimizerView from '../components/ImageOptimizerView.astro';
import { translations } from '../i18n/translations';

const t = translations.ko;
---

<BaseLayout
  locale="ko"
  title={t.imageOptimizer.metaTitle}
  description={t.imageOptimizer.metaDesc}
  activeNav="image-optimizer"
>
  <ImageOptimizerView locale="ko" />
</BaseLayout>

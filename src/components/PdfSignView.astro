---
import CategorySubNav from './CategorySubNav.astro';
import ToolSeoGuide from './ToolSeoGuide.astro';
import { translations, type Locale } from '../i18n/translations';
import { getExtra2Copy } from '../i18n/extraTools2';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translations[locale];
const copy = getExtra2Copy(locale).pdfSign;
---

<section class="page-header">
  <div class="page-header-top">
    <h1>{copy.title}</h1>
    <span class="trust-pill">
      <span class="trust-dot" aria-hidden="true"></span>
      {t.localBadge}
    </span>
  </div>
  <p>{copy.subtitle}</p>
</section>

<CategorySubNav locale={locale} category="pdf" activeId="pdf-sign" />

<div id="pdf-sign-root" data-done-msg={copy.doneMsg} data-no-stamp={copy.noStamp}>
  <div class="workspace-grid">
    <aside class="card panel">
      <div class="segmented-control" role="tablist">
        <button type="button" class="segmented-btn active" role="tab" data-sign-mode="draw">{copy.modeDraw}</button>
        <button type="button" class="segmented-btn" role="tab" data-sign-mode="stamp">{copy.modeStamp}</button>
      </div>

      <div data-sign-panel="draw">
        <canvas
          data-sign-pad
          width="360"
          height="150"
          style="width: 100%; height: 120px; background: #ffffff; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); touch-action: none; cursor: crosshair;"
        ></canvas>
        <button type="button" class="btn btn-secondary btn-sm" style="margin-top: 8px; width: 100%;" data-sign-clear-pad>
          {copy.clearPad}
        </button>
      </div>

      <div data-sign-panel="stamp" hidden>
        <div class="file-picker-box">
          <input id="sign-stamp" type="file" accept="image/*" hidden data-sign-stamp-input />
          <label for="sign-stamp" class="btn btn-secondary btn-sm" style="margin: 0; cursor: pointer;">
            {copy.stampPick}
          </label>
          <span class="file-picker-name" data-sign-stamp-name>{copy.noStamp}</span>
        </div>
      </div>

      <div class="field" style="margin-top: 16px;">
        <label for="sign-size">
          <span>{copy.sizeLabel}</span>
          <span data-sign-size-val>22%</span>
        </label>
        <input id="sign-size" type="range" min="8" max="45" value="22" data-sign-size />
      </div>

      <div class="btn-row" style="margin-top: 16px;">
        <button type="button" class="btn btn-trust" style="flex: 1;" data-sign-save disabled>
          {copy.saveBtn}
        </button>
      </div>
      <div class="btn-row" style="margin-top: 8px;">
        <button type="button" class="btn btn-secondary" style="width: 100%;" data-sign-change disabled>
          {copy.changePdf}
        </button>
      </div>
      <div class="status-banner" data-sign-status></div>
    </aside>

    <div>
      <div class="dropzone" data-sign-drop role="button" tabindex="0">
        <input type="file" accept="application/pdf" hidden data-sign-input />
        <h2>{copy.dropTitle}</h2>
        <p>{copy.dropHint}</p>
        <span class="btn btn-primary btn-sm">{copy.selectFile}</span>
      </div>

      <div class="canvas-stage" data-sign-stage hidden>
        <div class="btn-row" style="width: 100%; justify-content: space-between; align-items: center; margin-bottom: 12px;">
          <div class="btn-row" style="align-items: center;">
            <button type="button" class="btn btn-secondary btn-sm" data-sign-prev disabled>{copy.prevPage}</button>
            <span class="tabular-nums" style="font-size: 0.85rem; font-weight: 700;" data-sign-page-label>1 / 1</span>
            <button type="button" class="btn btn-secondary btn-sm" data-sign-next disabled>{copy.nextPage}</button>
          </div>
          <button type="button" class="btn btn-secondary btn-sm" data-sign-clear-marks disabled>
            {copy.clearMarks}
          </button>
        </div>
        <p style="margin: 0 0 10px; font-size: 0.83rem; color: var(--ink-muted);">{copy.placeTip}</p>
        <canvas data-sign-pdf-canvas></canvas>
      </div>
    </div>
  </div>
</div>

<ToolSeoGuide locale={locale} toolKey="pdf-sign" />

<script>
  import { initPdfSign } from '../scripts/pdf-sign';
  const root = document.getElementById('pdf-sign-root');
  if (root) initPdfSign(root);
</script>

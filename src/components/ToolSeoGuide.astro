---
import type { Locale } from '../i18n/translations';
import { toolGuides, type GuideKey } from '../i18n/toolGuides';

interface Props {
  locale: Locale;
  toolKey: GuideKey;
}

const { locale, toolKey } = Astro.props;
const guide = toolGuides[locale][toolKey];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: guide.faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="card info-box">
  <h2>{guide.howToTitle}</h2>
  <ol style="margin: 0; padding-left: 20px; color: var(--ink-secondary); font-size: 0.92rem; display: flex; flex-direction: column; gap: 8px; line-height: 1.65;">
    {guide.steps.map((step) => <li>{step}</li>)}
  </ol>
</section>

<section style="margin-top: 20px;">
  <h2 style="margin: 0 0 12px; font-size: 1.12rem; font-weight: 700;">{guide.faqTitle}</h2>
  <div class="faq-list">
    {guide.faqs.map((faq) => (
      <article class="card faq-item">
        <h3>{faq.q}</h3>
        <p>{faq.a}</p>
      </article>
    ))}
  </div>
</section>

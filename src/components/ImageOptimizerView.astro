---
import CategorySubNav from './CategorySubNav.astro';
import ToolSeoGuide from './ToolSeoGuide.astro';
import { translations, type Locale } from '../i18n/translations';
import { getExtraCopy } from '../i18n/extraTools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translations[locale];
const copy = t.imageOptimizer;
const compareCopy = getExtraCopy(locale).compare;
const clientLabels = {
  exifFound: copy.exifFound,
  exifGps: copy.exifGps,
  exifClean: copy.exifClean,
  exifRemovedBadge: copy.exifRemovedBadge,
  exifPreservedBadge: copy.exifPreservedBadge,
  exifUnsupportedBadge: copy.exifUnsupportedBadge,
  statusReady: copy.statusReady,
  statusProcessing: copy.statusProcessing,
  statusDone: copy.statusDone,
  statusError: copy.statusError,
  downloadSingle: copy.downloadSingle,
  emptyState: copy.emptyState,
  processAll: copy.processAll,
  largeBatchWarn: copy.largeBatchWarn,
  canvasLimitError: copy.canvasLimitError,
  cancelledMsg: copy.cancelledMsg,
  compareBtn: compareCopy.btnLabel,
  compareBefore: compareCopy.before,
  compareAfter: compareCopy.after,
};
---

<section class="page-header">
  <div class="page-header-top">
    <h1>{copy.title}</h1>
    <span class="trust-pill">
      <span class="trust-dot" aria-hidden="true"></span>
      {t.localBadge}
    </span>
  </div>
  <p>{copy.subtitle}</p>
</section>

<CategorySubNav locale={locale} category="image" activeId="image-optimizer" />

<div id="image-optimizer-root" data-labels={JSON.stringify(clientLabels)}>
  <div class="workspace-grid">
    <aside class="card panel">
      <h2 class="panel-title">{copy.formatLabel} &amp; EXIF</h2>

      <div class="field">
        <label for="opt-format">{copy.formatLabel}</label>
        <select id="opt-format" data-format>
          <option value="image/webp" selected>{locale === 'ko' ? 'WebP (권장)' : 'WebP (Recommended)'}</option>
          <option value="image/jpeg">JPG / JPEG</option>
          <option value="image/png">{locale === 'ko' ? 'PNG (무손실)' : 'PNG (Lossless)'}</option>
        </select>
      </div>

      <div class="field">
        <label for="opt-quality">
          <span>{copy.qualityLabel}</span>
          <span data-quality-value>82%</span>
        </label>
        <input id="opt-quality" type="range" min="30" max="100" value="82" data-quality />
      </div>

      <div class="field">
        <label for="opt-max-width">{copy.maxWidthLabel}</label>
        <select id="opt-max-width" data-max-width>
          <option value="0" selected>{copy.maxWidthNone}</option>
          <option value="2560">2560 px (QHD)</option>
          <option value="1920">1920 px (Full HD)</option>
          <option value="1280">{locale === 'ko' ? '1280 px (블로그 · 웹용)' : '1280 px (Blog / Web)'}</option>
          <option value="800">{locale === 'ko' ? '800 px (모바일 · 경량)' : '800 px (Mobile / Light)'}</option>
        </select>
      </div>

      <div class="field">
        <label class="checkbox-card">
          <input type="checkbox" checked data-strip-exif />
          <div>
            <strong>{copy.stripExifLabel}</strong>
            <span>{copy.stripExifDesc}</span>
          </div>
        </label>
      </div>

      <div class="btn-row" style="margin-top: 18px;">
        <button type="button" class="btn btn-primary" style="flex: 1;" data-process-all disabled>
          {copy.processAll}
        </button>
        <button type="button" class="btn btn-secondary btn-side" data-cancel-all disabled>
          {copy.cancelBtn}
        </button>
      </div>
      <div class="btn-row" style="margin-top: 8px;">
        <button type="button" class="btn btn-trust" style="flex: 1;" data-download-zip disabled>
          {copy.downloadZip}
        </button>
        <button type="button" class="btn btn-secondary btn-side" data-clear-all disabled>
          {copy.clearAll}
        </button>
      </div>
      <div class="status-banner" data-batch-banner></div>
    </aside>

    <div>
      <div class="dropzone" data-dropzone role="button" tabindex="0">
        <input type="file" accept="image/*" multiple hidden data-file-input />
        <div class="dropzone-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="17 8 12 3 7 8" />
            <line x1="12" y1="3" x2="12" y2="15" />
          </svg>
        </div>
        <h2>{copy.dropTitle}</h2>
        <p>{copy.dropHint}</p>
        <span class="btn btn-primary btn-sm">{copy.selectFiles}</span>
        <div class="paste-hint">
          <kbd>Ctrl+V</kbd> / <kbd>⌘+V</kbd> {locale === 'ko' ? '클립보드 이미지 붙여넣기 지원' : 'clipboard image paste supported'}
        </div>
      </div>

      <div class="stats-bar">
        <div class="stat-box">
          <div class="stat-label">{copy.summaryBefore}</div>
          <div class="stat-value" data-stat-before>0 B</div>
        </div>
        <div class="stat-box">
          <div class="stat-label">{copy.summaryAfter}</div>
          <div class="stat-value" data-stat-after>-</div>
        </div>
        <div class="stat-box">
          <div class="stat-label">{copy.summarySaved}</div>
          <div class="stat-value saved" data-stat-saved>-</div>
        </div>
      </div>

      <div class="file-list" data-file-list></div>
    </div>
  </div>

  <!-- Before / After Compare Modal -->
  <div class="modal-backdrop" data-compare-modal hidden role="dialog" aria-modal="true" aria-label={compareCopy.title}>
    <div class="modal-card">
      <div class="modal-head">
        <h3>{compareCopy.title}</h3>
        <button type="button" class="btn btn-secondary btn-sm" data-compare-close>{compareCopy.close}</button>
      </div>
      <div class="compare-wrap">
        <div class="compare-box">
          <img data-compare-before-img alt={compareCopy.before} />
          <div class="compare-after-layer" data-compare-after-layer>
            <img data-compare-after-img alt={compareCopy.after} />
          </div>
          <div class="compare-divider" data-compare-divider></div>
        </div>
      </div>
      <div class="compare-labels">
        <span data-compare-before-label>{compareCopy.before}</span>
        <input type="range" min="0" max="100" value="50" data-compare-slider aria-label="Before and after split" />
        <span data-compare-after-label>{compareCopy.after}</span>
      </div>
    </div>
  </div>
</div>

<ToolSeoGuide locale={locale} toolKey="image-optimizer" />

<script>
  import { initImageOptimizer } from '../scripts/image-optimizer';
  const root = document.getElementById('image-optimizer-root');
  if (root) initImageOptimizer(root);
</script>

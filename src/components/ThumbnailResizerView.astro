---
import CategorySubNav from './CategorySubNav.astro';
import ToolSeoGuide from './ToolSeoGuide.astro';
import { translations, type Locale } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translations[locale];
const copy = t.thumbnailResizer;
const clientLabels = {
  downloadSingle: copy.downloadSingle,
  statusReady: copy.statusReady,
  statusDone: copy.statusDone,
  processAll: copy.processAll,
  largeBatchWarn: copy.largeBatchWarn,
};
---

<section class="page-header">
  <div class="page-header-top">
    <h1>{copy.title}</h1>
    <span class="trust-pill">
      <span class="trust-dot" aria-hidden="true"></span>
      {t.localBadge}
    </span>
  </div>
  <p>{copy.subtitle}</p>
</section>

<CategorySubNav locale={locale} category="image" activeId="thumbnail-resizer" />

<div id="thumbnail-resizer-root" data-labels={JSON.stringify(clientLabels)}>
  <div class="workspace-grid">
    <aside class="card panel">
      <h2 class="panel-title">{copy.presetsTitle}</h2>
      <div class="preset-grid">
        {copy.presets.map((preset, idx) => (
          <button
            type="button"
            class:list={['preset-btn', { active: idx === 0 }]}
            data-preset-btn
            data-w={preset.width}
            data-h={preset.height}
          >
            <div>
              <strong>{preset.name}</strong>
              <small>{preset.width} × {preset.height} px</small>
            </div>
            <span class="preset-ratio">{preset.ratio}</span>
          </button>
        ))}
      </div>

      <h3 class="panel-title" style="margin-top: 18px;">{copy.customSizeTitle}</h3>
      <div class="field field-row">
        <div>
          <label for="thumb-w">{copy.widthLabel}</label>
          <input id="thumb-w" type="number" min="16" max="8000" value="1280" data-width />
        </div>
        <div>
          <label for="thumb-h">{copy.heightLabel}</label>
          <input id="thumb-h" type="number" min="16" max="8000" value="720" data-height />
        </div>
      </div>

      <div class="field">
        <label for="thumb-fit">{copy.fitModeLabel}</label>
        <select id="thumb-fit" data-fit>
          <option value="cover" selected>{copy.fitCover}</option>
          <option value="contain">{copy.fitContain}</option>
          <option value="fill">{copy.fitFill}</option>
        </select>
      </div>

      <div class="field field-row">
        <div>
          <label for="thumb-bg">{copy.bgColorLabel}</label>
          <input id="thumb-bg" type="color" value="#ffffff" style="height: 38px; padding: 3px;" data-bg />
        </div>
        <div>
          <label for="thumb-format">{copy.formatLabel}</label>
          <select id="thumb-format" data-format>
            <option value="image/webp" selected>WebP</option>
            <option value="image/jpeg">JPG</option>
            <option value="image/png">PNG</option>
          </select>
        </div>
      </div>

      <div class="field">
        <label for="thumb-quality">
          <span>{copy.qualityLabel}</span>
          <span data-quality-value>88%</span>
        </label>
        <input id="thumb-quality" type="range" min="40" max="100" value="88" data-quality />
      </div>

      <div class="btn-row" style="margin-top: 18px;">
        <button type="button" class="btn btn-primary" style="flex: 1;" data-process-all disabled>
          {copy.processAll}
        </button>
        <button type="button" class="btn btn-secondary btn-side" data-cancel-all disabled>
          {copy.cancelBtn}
        </button>
      </div>
      <div class="btn-row" style="margin-top: 8px;">
        <button type="button" class="btn btn-trust" style="flex: 1;" data-download-zip disabled>
          {copy.downloadZip}
        </button>
        <button type="button" class="btn btn-secondary btn-side" data-clear-all disabled>
          {copy.clearAll}
        </button>
      </div>
      <div class="status-banner" data-batch-banner></div>
    </aside>

    <div>
      <div class="dropzone" data-dropzone role="button" tabindex="0">
        <input type="file" accept="image/*" multiple hidden data-file-input />
        <div class="dropzone-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <circle cx="8.5" cy="8.5" r="1.5" />
            <polyline points="21 15 16 10 5 21" />
          </svg>
        </div>
        <h2>{copy.dropTitle}</h2>
        <p>{copy.dropHint}</p>
        <span class="btn btn-primary btn-sm">{copy.selectFiles}</span>
      </div>

      <div class="file-list" data-file-list></div>
    </div>
  </div>
</div>

<ToolSeoGuide locale={locale} toolKey="thumbnail-resizer" />

<script>
  import { initThumbnailResizer } from '../scripts/thumbnail-resizer';
  const root = document.getElementById('thumbnail-resizer-root');
  if (root) initThumbnailResizer(root);
</script>

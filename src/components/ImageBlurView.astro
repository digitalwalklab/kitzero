---
import CategorySubNav from './CategorySubNav.astro';
import { translations, type Locale } from '../i18n/translations';
import { getExtraCopy } from '../i18n/extraTools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translations[locale];
const copy = getExtraCopy(locale).imageBlur;
---

<section class="page-header">
  <div class="page-header-top">
    <h1>{copy.title}</h1>
    <span class="trust-pill">
      <span class="trust-dot" aria-hidden="true"></span>
      {t.localBadge}
    </span>
  </div>
  <p>{copy.subtitle}</p>
</section>

<CategorySubNav locale={locale} category="image" activeId="image-blur" />

<div id="image-blur-root">
  <div class="workspace-grid">
    <aside class="card panel">
      <div class="field">
        <label for="blur-mode">{copy.modeLabel}</label>
        <select id="blur-mode" data-blur-mode>
          <option value="mosaic" selected>{copy.modeMosaic}</option>
          <option value="blur">{copy.modeBlur}</option>
          <option value="solid">{copy.modeSolid}</option>
        </select>
      </div>

      <div class="field">
        <label for="blur-strength">
          <span>{copy.strengthLabel}</span>
          <span data-blur-strength-val>24</span>
        </label>
        <input id="blur-strength" type="range" min="8" max="60" value="24" data-blur-strength />
      </div>

      <div class="field">
        <label for="blur-format">{copy.formatLabel}</label>
        <select id="blur-format" data-blur-format>
          <option value="image/webp" selected>WebP</option>
          <option value="image/jpeg">JPG</option>
          <option value="image/png">PNG</option>
        </select>
      </div>

      <div class="stat-box" style="margin-bottom: 14px;">
        <div class="stat-label">{copy.regionsCount}</div>
        <div class="stat-value" data-blur-count>0</div>
      </div>

      <div class="btn-row">
        <button type="button" class="btn btn-secondary" style="flex: 1;" data-blur-undo disabled>
          {copy.undoBtn}
        </button>
        <button type="button" class="btn btn-secondary" style="flex: 1;" data-blur-clear disabled>
          {copy.clearBoxesBtn}
        </button>
      </div>

      <div class="btn-row" style="margin-top: 8px;">
        <button type="button" class="btn btn-trust" style="flex: 1;" data-blur-download disabled>
          {copy.downloadBtn}
        </button>
      </div>

      <div class="btn-row" style="margin-top: 8px;">
        <button type="button" class="btn btn-secondary" style="width: 100%;" data-blur-change disabled>
          {copy.changeImgBtn}
        </button>
      </div>
    </aside>

    <div>
      <div class="dropzone" data-blur-drop role="button" tabindex="0">
        <input type="file" accept="image/*" hidden data-blur-input />
        <h2>{copy.dropTitle}</h2>
        <p>{copy.dropHint}</p>
        <span class="btn btn-primary btn-sm">{copy.selectFile}</span>
      </div>

      <div class="canvas-stage" data-blur-stage hidden>
        <p style="margin: 0 0 12px; font-size: 0.85rem; color: var(--ink-muted);">{copy.dragTip}</p>
        <canvas data-blur-canvas></canvas>
      </div>
    </div>
  </div>
</div>

<script>
  import { initImageBlur } from '../scripts/image-blur';
  const root = document.getElementById('image-blur-root');
  if (root) initImageBlur(root);
</script>

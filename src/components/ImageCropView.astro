---
import CategorySubNav from './CategorySubNav.astro';
import { translations, type Locale } from '../i18n/translations';
import { getExtra2Copy } from '../i18n/extraTools2';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translations[locale];
const copy = getExtra2Copy(locale).imageCrop;
---

<section class="page-header">
  <div class="page-header-top">
    <h1>{copy.title}</h1>
    <span class="trust-pill">
      <span class="trust-dot" aria-hidden="true"></span>
      {t.localBadge}
    </span>
  </div>
  <p>{copy.subtitle}</p>
</section>

<CategorySubNav locale={locale} category="image" activeId="image-crop" />

<div id="image-crop-root">
  <div class="workspace-grid">
    <aside class="card panel">
      <div class="field">
        <label for="crop-ratio">{copy.ratioLabel}</label>
        <select id="crop-ratio" data-crop-ratio>
          <option value="0" selected>{copy.ratioFree}</option>
          <option value="1">1 : 1</option>
          <option value="1.777777">16 : 9</option>
          <option value="1.333333">4 : 3</option>
          <option value="0.75">3 : 4</option>
        </select>
      </div>

      <div class="field">
        <label>{copy.transformLabel}</label>
        <div class="field-row" style="margin-bottom: 8px;">
          <button type="button" class="btn btn-secondary btn-sm" data-crop-rot-l disabled>↺ {copy.rotLeft}</button>
          <button type="button" class="btn btn-secondary btn-sm" data-crop-rot-r disabled>↻ {copy.rotRight}</button>
        </div>
        <div class="field-row">
          <button type="button" class="btn btn-secondary btn-sm" data-crop-flip-h disabled>⇄ {copy.flipH}</button>
          <button type="button" class="btn btn-secondary btn-sm" data-crop-flip-v disabled>⇅ {copy.flipV}</button>
        </div>
      </div>

      <div class="field">
        <label for="crop-format">{copy.formatLabel}</label>
        <select id="crop-format" data-crop-format>
          <option value="image/webp" selected>WebP</option>
          <option value="image/jpeg">JPG</option>
          <option value="image/png">PNG</option>
        </select>
      </div>

      <div class="stat-box" style="margin-bottom: 14px;">
        <div class="stat-label">Crop Area</div>
        <div class="stat-value" data-crop-dims>-</div>
      </div>

      <div class="btn-row">
        <button type="button" class="btn btn-trust" style="flex: 1;" data-crop-download disabled>
          {copy.downloadBtn}
        </button>
      </div>
      <div class="btn-row" style="margin-top: 8px;">
        <button type="button" class="btn btn-secondary" style="flex: 1;" data-crop-reset disabled>
          {copy.resetCrop}
        </button>
        <button type="button" class="btn btn-secondary" style="flex: 1;" data-crop-change disabled>
          {copy.changeImg}
        </button>
      </div>
    </aside>

    <div>
      <div class="dropzone" data-crop-drop role="button" tabindex="0">
        <input type="file" accept="image/*" hidden data-crop-input />
        <h2>{copy.dropTitle}</h2>
        <p>{copy.dropHint}</p>
        <span class="btn btn-primary btn-sm">{copy.selectFile}</span>
      </div>

      <div class="canvas-stage" data-crop-stage hidden>
        <p style="margin: 0 0 12px; font-size: 0.85rem; color: var(--ink-muted);">{copy.dragTip}</p>
        <canvas data-crop-canvas></canvas>
      </div>
    </div>
  </div>
</div>

<script>
  import { initImageCrop } from '../scripts/image-crop';
  const root = document.getElementById('image-crop-root');
  if (root) initImageCrop(root);
</script>
